<!-- These resources are around just to allow their values to be customized
     for different hardware and product builds. -->
<resources>
    <!-- Whether a software navigation bar should be shown. NOTE: in the future this may be
         autodetected from the Configuration. -->
    <bool name="config_showNavigationBar">true</bool>
    <integer name="config_minimumScreenOffTimeout">2147483647</integer>
    <integer name="config_screenTimeoutOverride">2147483647</integer>
    <bool name="config_disableLockscreenByDefault">true</bool>
    <bool name="config_isDesktopModeSupported">true</bool>
    <bool name="config_canInternalDisplayHostDesktops">true</bool>
    <bool name="config_enterDesktopByDefaultOnFreeformDisplay">true</bool>
    <bool name="config_isDesktopModeDevOptionSupported">true</bool>
    <integer name="config_maxDesktopWindowingDesks">0</integer>
    <integer name="config_supportsNonResizableMultiWindow">1</integer>
    <integer name="config_respectsActivityMinWidthHeightMultiWindow">0</integer>
    <string name="config_externalSystemServer" translatable="false">org.openfde.platform.internal.OpenfdeSystemServer</string>
    <string-array name="config_externalOpenfdeServices">
	    <item>org.openfde.platform.internal.OpenfdeService</item>
    </string-array>
    <bool name="config_single_volume">true</bool>
</resources>
